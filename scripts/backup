#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

# /var/www/$app/ : rebuilt from repo source on restore, back up everything
# except the venv (large, regenerated by myynh_setup_venv).
ynh_backup "$install_dir" --exclude=".venv"

# /home/yunohost.app/$app/ : sqlite db + secret key
ynh_backup "$data_dir"

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/logrotate.d/$app"

ynh_print_info "Backup script completed for $app."
